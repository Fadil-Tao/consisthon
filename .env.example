# Local development uses libSQL SQLite; replace with your Turso URL/token.
TURSO_DATABASE_URL=file:./data/consisthon.db
TURSO_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit development-only demo access. Ignored in production.
ENABLE_DEMO=true
# Private S3 bucket for proof files. Leave blank to store files locally in development.
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3, leave the endpoint blank and set AWS_REGION to your bucket region.
S3_ENDPOINT=
